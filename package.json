{
  "name": "timer-desktop",
  "version": "1.0.0",
  "description": "Timer analogico per non stare troppo seduti",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack:store": "electron-builder --win appx",
    "pack:exe": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0"
  },
  "author": "Gabriele Mele",
  "build": {
    "appId": "com.gabmele.timer",
    "productName": "Timer",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "app.js",
      "sounds.js",
      "i18n.js",
      "style.css",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "appx"
      ]
    },
    "appx": {
      "applicationId": "Timer",
      "displayName": "Timer",
      "identityName": "Placeholder.Timer",
      "publisher": "CN=00000000-0000-0000-0000-000000000000",
      "publisherDisplayName": "Gabriele Mele",
      "backgroundColor": "#000000",
      "languages": [
        "en-US",
        "fr-FR",
        "es-ES",
        "it-IT"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "multiLanguageInstaller": true,
      "installerLanguages": [
        "en_US",
        "fr_FR",
        "es_ES",
        "it_IT"
      ]
    }
  }
}