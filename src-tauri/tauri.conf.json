{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Timer",
  "version": "1.0.0",
  "identifier": "com.gabmele.timer",
  "build": { "frontendDist": "../web" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "Timer", "width": 340, "height": 440, "minWidth": 220, "minHeight": 280, "decorations": false, "backgroundColor": "#000000" }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
